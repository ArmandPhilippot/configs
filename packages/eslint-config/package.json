{
  "name": "@arphi/eslint-config",
  "description": "The shared ESLint configuration for my projects.",
  "version": "3.1.0",
  "license": "MIT",
  "keywords": [
    "eslint",
    "eslint-config",
    "config",
    "configuration"
  ],
  "author": {
    "name": "Armand Philippot",
    "email": "git@armand.philippot.eu",
    "url": "https://armand.philippot.eu/"
  },
  "homepage": "https://github.com/ArmandPhilippot/configs/packages/eslint-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArmandPhilippot/configs.git",
    "directory": "packages/eslint-config"
  },
  "bugs": {
    "url": "https://github.com/ArmandPhilippot/configs/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "build": "tsdown --clean --dts",
    "lint:deprecated-rules": "tsdown --clean --dts --out-dir .lint-deprecated-rules/dist && node scripts/check-deprecated-rules.mjs",
    "test": "vitest run",
    "watch": "tsdown --watch"
  },
  "dependencies": {
    "@e18e/eslint-plugin": "^0.8.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@typescript-eslint/parser": "^8.67.0",
    "@typescript-eslint/utils": "^8.67.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-unicorn": "^73.0.0",
    "globals": "^17.11.0",
    "typescript-eslint": "^8.67.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "astro-eslint-parser": "^3.0.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-jsdoc": "^64.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "tsdown": "^0.22.14",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "astro-eslint-parser": "^3.0.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-jsdoc": "^64.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "typescript": "^5.9.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "astro-eslint-parser": {
      "optional": true
    },
    "eslint-config-prettier": {
      "optional": true
    },
    "eslint-plugin-astro": {
      "optional": true
    },
    "eslint-plugin-jsdoc": {
      "optional": true
    },
    "eslint-plugin-jsx-a11y": {
      "optional": true
    },
    "eslint-plugin-no-only-tests": {
      "optional": true
    }
  }
}
